// -*- mode24jsonc -*-
{
  // "layer": "top", // Waybar at top layer
  "position": "top", // Waybar position (top|bottom|left|right)
  "height": 24, // Waybar height (to be removed for auto height)
  "spacing": 1, // Gaps between modules (4px)
  "modules-left": [
    "sway/workspaces",
    "sway/window"
  ],
  "modules-center": [
    "wlr/taskbar"
  ],
  "modules-right": [
    "backlight",
    "sway/mode",
    "sway/scratchpad",
    "sway/language",
    "idle_inhibitor",
    "pulseaudio",
    "network",
    "battery",
    "tray",
    "clock"
  ],

  // Modules configuration
  "sway/workspaces": {
    "format": "{icon}",
    "persistent-workspaces": {
      "10": ["eDP-1"],
      "11": ["eDP-1"],
      "12": ["eDP-1"],
      "13": ["eDP-1"],
      "14": ["eDP-1"],
      "15": ["eDP-1"],
      "16": ["eDP-1"],
      "17": ["eDP-1"],
      "18": ["eDP-1"],
      "19": ["eDP-1"],

      "20": ["HDMI-A-1"],
      "21": ["HDMI-A-1"],
      "22": ["HDMI-A-1"],
      "23": ["HDMI-A-1"],
      "24": ["HDMI-A-1"],
      "25": ["HDMI-A-1"],
      "26": ["HDMI-A-1"],
      "27": ["HDMI-A-1"],
      "28": ["HDMI-A-1"],
      "29": ["HDMI-A-1"]
    },

    "format-icons": {
      "10": "`",
      "11": "1",
      "12": "2",
      "13": "3",
      "14": "4",
      "15": "5",
      "16": "6",
      "17": "7",
      "18": "8",
      "19": "9",

      "20": "`",
      "21": "1",
      "22": "2",
      "23": "3",
      "24": "4",
      "25": "5",
      "26": "6",
      "27": "7",
      "28": "8",
      "29": "9"
    }
  },
  "sway/window": {
    "format": "{app_id}",
    "on-click-right": "swaymsg kill"
  },
"sway/language": {
    "format": "{short}"
},
  "sway/scratchpad": {
    "format": "{icon} {count}",
    "show-empty": false,
    "format-icons": ["", ""],
    "tooltip": true,
    "tooltip-format": "{app}: {title}"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": " ",
      "deactivated": " "
    }
  },
  "tray": {
    // "icon-size": 17,
    "tooltip-format": "{id}",
    "spacing": 7
  },
  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "<big>{:%d %B %Y}</big>\n<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "year",
      "mode-mon-col": 3,
      "format": {
        "today": "<span color='#000000' bgcolor='#FFFFFF'><b>{}</b></span>"
      }
    },
    "actions": {
      "on-click": "mode",
      "on-click-right": "shift_down",
      "on-click-middle": "shift_up"
    }
  },

  "backlight": {
    "states": {
        "full": 100
    },
    "format": "{icon}  {percent}%",
    "format-full": "",
    "format-icons": ["", "", "", "", "", "", "", "", ""],
    "on-scroll-up": "swayosd-client --brightness +5",
    "on-scroll-down": "swayosd-client --brightness -5",
    "on-click": "swayosd-client --brightness +100",
    "on-click-right" : "swayosd-client --brightness -100",
    "tooltip-format": "{percent}"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format-plugged": "",
    "format": "{icon}  {capacity}%",
    "format-full": "{icon}  {capacity}%",
    "format-charging": "{capacity}% 󰁹",
    // "format-plugged": "{capacity}% ",
    "format-icons": ["", "", "", "", ""],
    "on-click": "wlogout --primary-monitor eDP-1 -L 600 -R 600 -T 400 -B 400"
  },
  "network": {
    "format": "",
    // "interface": "wlp2*", // (Optional) To force the use of this interface
    "format-wifi": "   {signalStrength}%",
    "format-ethernet": "{ipaddr}/{cidr} ",
    "tooltip-format": "{essid}",
    "format-linked": "{ifname} (No IP) ",
    "format-disconnected": "⚠",
    "on-click": "nmgui"
  },
  "pulseaudio": {
    "on-scroll-up": "swayosd-client --output-volume +5 --max-volume 100",
    "on-scroll-down": "swayosd-client --output-volume -5 --max-volume 100",
    "format": "{icon}  {volume}%",
    "format-bluetooth": "{icon} {volume}% " ,
    "format-bluetooth-muted": "  {volume}% ",
    "format-muted": "  {volume}%",
    "format-source": "{volume}% ",
    "format-source-muted": "",
    "format-icons": {
      "headphone": "",
      "hands-free": "󰋋",
      "headset": "󰋋",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""]
    },
    "on-click": "pavucontrol",
    "on-click-right": "swayosd-client --output-volume mute-toggle",
    "on-click-middle": "swayosd-client --output-volume -100 --max-volume 100"
  },
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 20,

    "all-outputs": true,

    "on-click": "activate",
    "on-click-right": "close"
  }}
