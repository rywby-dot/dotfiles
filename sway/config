     $mod+Shift+4 exec $movefocus 4
     $mod+Shift+5 exec $movefocus 5
     $mod+Shift+6 exec $movefocus 6
     $mod+Shift+7 exec $movefocus 7
     $mod+Shift+8 exec $movefocus 8
     $mod+Shift+9 exec $movefocus 9
