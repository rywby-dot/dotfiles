# Example configuration:
#
output HDMI-A-1 resolution 2560x1440 position -2565,-900
output eDP-1 resolution 1920x1080 position 0,0
#
# You can get the names of your outputs by running: swaymsg -t get_outputs

### Idle configuration
#
# Example configuration:
#
exec swayidle -w \
    timeout 900 'swaymsg "input * xkb_switch_layout 0"; swaylock -f -c 000000' \
    before-sleep 'swaymsg "input * xkb_switch_layout 0"; swaylock -f -c 000000'
#
# This will lock your screen after 300 seconds of inactivity, then turn off
# your displays after another 300 seconds, and turn your screens back on when
# resumed. It will also lock your screen before your computer goes to sleep.

### Input configuration
#
# Keyboard
input type:keyboard {
    xkb_layout "us,ru"
    xkb_variant "colemak_dh,"
    xkb_options "grp:caps_toggle"

    repeat_delay 220
    repeat_rate 40

    xkb_numlock disable
}

# Touchpad
input type:touchpad {
    tap enabled
    dwt enabled
    drag enabled

    natural_scroll enabled

    pointer_accel 0.5
    accel_profile adaptive

    scroll_method edge
    click_method button_areas
    scroll_factor 0.9
}

# Mouse / other pointer devices
input type:pointer {
    pointer_accel 0.3
    accel_profile flat
}
#
# You can also configure each device individually.
# Read `man 5 sway-input` for more information about this section.

### Variables
