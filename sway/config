     $mod+4 exec swaysome focus 4
     $mod+5 exec swaysome focus 5
     $mod+6 exec swaysome focus 6
     $mod+7 exec swaysome focus 7
     $mod+8 exec swaysome focus 8
     $mod+9 exec swaysome focus 9
