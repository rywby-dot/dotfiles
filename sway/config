set $outputshot f="$HOME/Pictures/Screenshots/ScreenShot-$(date +'%F_%H-%M-%S').png" && o="$(swaymsg -t get_outputs | jq -r '.[] | select(.focused == true) | .name')" && grim -c -o "$o" "$f" && wl-copy <"$f" && notify-send "$o Screenshot" "saved to ~/Pictures/Screenshots/" -i "$f"
set $selectshot f="$HOME/Pictures/Screenshots/ScreenShot-$(date +'%F_%H-%M-%S').png" && grim -c -g "$(slurp)" "$f" && wl-copy <"$f" && notify-send "Area Screenshot" "saved to ~/Pictures/Screenshots/" -i "$f"
set $windowshot f="$HOME/Pictures/Screenshots/ScreenShot-$(date +'%F_%H-%M-%S').png" && id="$(swaymsg -t get_tree | jq -r '.. | objects | select(.focused? == true) | .foreign_toplevel_identifier // empty')" && grim -T "$id" "$f" && wl-copy <"$f" && notify-send "Window Screenshot" "saved to ~/Pictures/Screenshots/" -i "$f"

