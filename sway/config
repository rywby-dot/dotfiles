     $mod+c exec $movefocus focnext
     $mod+x exec $movefocus focprev
     $mod+Shift+c exec $movefocus next
     $mod+Shift+x exec $movefocus prev
     $mod+Alt+c workspace next_on_output
     $mod+Alt+x workspace prev_on_output
     $mod+Shift+Alt+c move container to workspace next_on_output; workspace next_on_output
     $mod+Shift+Alt+x move container to workspace prev_on_output; workspace prev_on_output

     $mod+f workspace number $ws20
     $mod+Shift+Return workspace number $ws20
# Note: workspaces can have any name you want, not just numbers.
